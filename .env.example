# Run pnpm run setup to generate local credentials in ignored .env.local.
STORAGE_DRIVER=file
DATA_DIR=local-data/store
APP_ACCESS_KEY_HASH=
AGENT_API_TOKEN_HASH=
SESSION_SECRET=
# Vercel: STORAGE_DRIVER=blob, private store token automatically connected.
BLOB_READ_WRITE_TOKEN=
# CLI only; never use VITE_ prefixes for secrets.
ITINERARY_API_URL=http://localhost:5173
ITINERARY_API_TOKEN=
# AI is off by default. See docs/AI-DEVELOPMENT.md; local no-cost demo: pnpm ai:demo.
AI_MODE=disabled
# Independent operator credential; never reuse the family key or agent token.
AI_ADMIN_TOKEN_HASH=
# CLI only, in an ignored operator environment file:
ITINERARY_AI_ADMIN_TOKEN=
# Live use requires verified prices, billing controls and explicit enablement.
OPENAI_API_KEY=
OPENROUTESERVICE_API_KEY=
AI_PRICING_JSON=
AI_LIVE_ENABLED=false
AI_PROVIDER_SPEND_CAP_CONFIRMED=false
AI_ROUTING_FREE_PLAN_CONFIRMED=false
AI_LOCAL_LIVE_ENABLED=false
AI_PRODUCTION_ENABLED=false
# Feature-branch preview requires a separate private Blob store and credentials.
AI_PREVIEW_ENABLED=false
AI_PREVIEW_STORE_ID=
BLOB_STORE_ID=
