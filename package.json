{
  "name": "itinerary-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "build": "pnpm check:server && node --import tsx scripts/assets.ts && tsc --noEmit && vite build && node --import tsx scripts/seed-staging.ts",
    "check:server": "tsc --project tsconfig.server.json && node scripts/check-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "trip": "node --import tsx scripts/trip.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "ai:demo": "node --import tsx scripts/ai-demo.ts",
    "ai:admin": "node --import tsx scripts/ai-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-openapi": "^1.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@vercel/blob": "^2.4.0",
    "dexie": "^4.2.0",
    "dotenv": "^17.2.0",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-window": "^7.4.1"
  }
}
